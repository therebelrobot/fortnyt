# Copy to .env and fill in. Never commit .env.

# Encrypts the stored SimpleFIN access URL. Long random string; keep it — without it the
# saved connection can't be read and you'd need a new Setup Token.
#   openssl rand -base64 32
FORTNYT_SECRET=

# Browser login (HTTP Basic). Leave empty only if the port is unreachable from anywhere you don't trust.
APP_USER=fortnyt
APP_PASSWORD=

# Default time zone on first start (can be changed later in Setup → Preferences).
FORTNYT_TZ=America/New_York
